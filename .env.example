# Copy to .env and add a Groq key (https://console.groq.com).
GROQ_API_KEY=
LLM_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile

RETRIEVAL_TOP_K=6

# Optional. Any OpenAI-compatible endpoint works (Groq, OpenAI, Ollama's /v1, ...).
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# RETRIEVAL_TOP_K=6
# LLM_CACHE=1
